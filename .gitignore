.env
# No trailing slash: the repo root .venv is a symlink to apps/backend/.venv,
# and a directory-only pattern would not match it.
.venv
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
node_modules/
.next/
out/
*.tsbuildinfo
.DS_Store
.cursor/
apps/backend/.env
apps/web/.env
apps/web/.env.local
packages/contracts/openapi.json
packages/contracts/src/openapi.ts
data/
*.log
