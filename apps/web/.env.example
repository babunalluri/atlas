# Clerk (organization-aware JWT template required for AgentOS)
# Publishable/secret keys must belong to the same Clerk instance as root
# CLERK_ISSUER / CLERK_JWKS_URL (emerging-unicorn-41.clerk.accounts.dev).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin/agents
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/admin/agents

# AgentOS / admin API base URL (browser calls this directly with Clerk bearer)
NEXT_PUBLIC_AGENTOS_URL=http://localhost:7777
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production-like local auth (docker-compose also forces NEXT_PUBLIC_DEV_AUTH=false).
# For a no-Clerk bypass (backend AUTH_DISABLED=true), set NEXT_PUBLIC_DEV_AUTH=true.
NEXT_PUBLIC_DEV_AUTH=false
NEXT_PUBLIC_USE_MOCKS=0
