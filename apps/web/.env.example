NEXT_PUBLIC_AGENTOS_URL=http://localhost:7777
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js + Keycloak (open-source IdP — replaces Clerk)
AUTH_URL=http://localhost:3000
AUTH_SECRET=dev-only-auth-secret-change-me-please
AUTH_KEYCLOAK_ID=atlas-web
AUTH_KEYCLOAK_SECRET=atlas-web-dev-secret-change-me
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/atlas
# AUTH_KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/atlas
NEXT_PUBLIC_AUTH_PROVIDER=keycloak

# Local bypass only (never in shared envs)
NEXT_PUBLIC_DEV_AUTH=false
NEXT_PUBLIC_DEV_TENANT_ID=11111111-1111-1111-1111-111111111111
NEXT_PUBLIC_DEV_USER_ID=dev-admin
NEXT_PUBLIC_DEV_ROLE=tenant_admin
