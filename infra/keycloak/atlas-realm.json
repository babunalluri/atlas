{
  "realm": "atlas",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "sslRequired": "external",
  "roles": {
    "realm": [
      { "name": "platform_admin", "description": "Atlas platform administrator" },
      { "name": "default-roles-atlas", "composite": true }
    ]
  },
  "groups": [
    {
      "name": "org_demo_acme",
      "path": "/org_demo_acme",
      "attributes": { "org_id": ["org_demo_acme"] }
    },
    {
      "name": "org_demo_globex",
      "path": "/org_demo_globex",
      "attributes": { "org_id": ["org_demo_globex"] }
    }
  ],
  "clients": [
    {
      "clientId": "atlas-web",
      "name": "Atlas Web",
      "enabled": true,
      "publicClient": false,
      "secret": "atlas-web-dev-secret-change-me",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000",
        "+"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*##http://127.0.0.1:3000/*"
      },
      "protocolMappers": [
        {
          "name": "org_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "org_role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_role",
            "claim.name": "org_role",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "platform_admin",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "platform_admin",
            "claim.name": "platform_admin",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience-atlas-web",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "atlas-web",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "preferred_username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin@atlas.local",
      "email": "admin@atlas.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Atlas",
      "lastName": "Admin",
      "attributes": {
        "org_id": ["org_demo_acme"],
        "org_role": ["org:admin"],
        "platform_admin": ["true"]
      },
      "groups": ["/org_demo_acme"],
      "credentials": [
        {
          "type": "password",
          "value": "atlas-admin",
          "temporary": false
        }
      ],
      "realmRoles": ["platform_admin"]
    },
    {
      "username": "ops@acme.atlas.local",
      "email": "ops@acme.atlas.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Acme",
      "lastName": "Ops",
      "attributes": {
        "org_id": ["org_demo_acme"],
        "org_role": ["org:admin"],
        "platform_admin": ["false"]
      },
      "groups": ["/org_demo_acme"],
      "credentials": [
        {
          "type": "password",
          "value": "atlas-acme",
          "temporary": false
        }
      ]
    }
  ]
}
