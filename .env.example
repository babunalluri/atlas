# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_URL=http://localhost:7777
NEXT_PUBLIC_AGENTOS_URL=http://localhost:7777
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL + pgvector
POSTGRES_DB=agent_saas
POSTGRES_USER=agent_saas
POSTGRES_PASSWORD=agent_saas_dev
DATABASE_URL=postgresql+asyncpg://agent_saas:agent_saas_dev@postgres:5432/agent_saas
AGNO_DATABASE_URL=postgresql+psycopg://agent_saas:agent_saas_dev@postgres:5432/agent_saas

# Clerk organizations and JWT template
# Issuer/JWKS must match the Clerk instance behind NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_JWKS_URL=https://emerging-unicorn-41.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://emerging-unicorn-41.clerk.accounts.dev
CLERK_AUDIENCE=agent-saas

# Production-like local auth (matches docker-compose overrides).
# For a no-Clerk bypass, set both to true (local only — never in shared envs).
AUTH_DISABLED=false
NEXT_PUBLIC_DEV_AUTH=false
NEXT_PUBLIC_DEV_TENANT_ID=11111111-1111-1111-1111-111111111111
NEXT_PUBLIC_DEV_USER_ID=dev-admin
NEXT_PUBLIC_DEV_ROLE=tenant_admin

# Model/search credentials (platform-owned defaults)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
EXA_API_KEY=

# Credential envelope encryption. Generate a Fernet key for local development.
CREDENTIAL_ENCRYPTION_KEY=dev-only-change-me-please-32b
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=
DOCUMENT_BUCKET=
DOCUMENT_UPLOAD_DIR=/data/uploads

# Outbound REST tool policy
REST_TOOL_ALLOWED_HOSTS=api.example.com,httpbin.org,api.freshdesk.com,example.freshdesk.com,ozonetel888.freshdesk.com,dev2.cloud-connect.in
RATE_LIMIT_PER_MINUTE=60
TENANT_CONCURRENCY_LIMIT=10
MAX_UPLOAD_BYTES=10485760
