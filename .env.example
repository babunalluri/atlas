# Runtime
# Local compose: development. Deployed environments must use production or staging.
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_URL=http://localhost:7777
NEXT_PUBLIC_AGENTOS_URL=http://localhost:7777
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL + pgvector
# POSTGRES_USER owns tables / runs migrations (may be superuser in Docker).
# Runtime uses agent_saas_app (NOSUPERUSER, NOBYPASSRLS) so FORCE RLS applies.
POSTGRES_DB=agent_saas
POSTGRES_USER=agent_saas
POSTGRES_PASSWORD=agent_saas_dev
POSTGRES_APP_PASSWORD=agent_saas_dev
DATABASE_URL=postgresql+asyncpg://agent_saas_app:agent_saas_dev@postgres:5432/agent_saas
MIGRATION_DATABASE_URL=postgresql+asyncpg://agent_saas:agent_saas_dev@postgres:5432/agent_saas
AGNO_DATABASE_URL=postgresql+psycopg://agent_saas_app:agent_saas_dev@postgres:5432/agent_saas
ENCRYPTION_KEY_VERSION=local-v1
# ENCRYPTION_PREVIOUS_KEYS=local-v0:old-secret-here
EMBEDDING_DIMENSIONS=1536
# Knowledge retrieval quality (Atlas-owned RAG; not agno.knowledge)
# KNOWLEDGE_CHUNK_SIZE=1200
# KNOWLEDGE_CHUNK_OVERLAP=150
# KNOWLEDGE_RRF_K=60
# KNOWLEDGE_RERANKER=local   # local | cohere | off
# KNOWLEDGE_COHERE_RERANK_MODEL=rerank-v3.5
# COHERE_API_KEY=
SANDBOX_INTERNAL_TOKEN=dev-sandbox-internal-token-change-me

# Staff auth — Keycloak OIDC (see docs/auth.md). Clerk is no longer required.
AUTH_PROVIDER=oidc
AUTH_ISSUER=http://localhost:8080/realms/atlas
AUTH_JWKS_URL=http://localhost:8080/realms/atlas/protocol/openid-connect/certs
AUTH_AUDIENCE=atlas-web
AUTH_ADMIN_SECRET=
# Auth.js (web)
AUTH_URL=http://localhost:3000
AUTH_SECRET=dev-only-auth-secret-change-me-please
AUTH_KEYCLOAK_ID=atlas-web
AUTH_KEYCLOAK_SECRET=atlas-web-dev-secret-change-me
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/atlas
# Optional: in-network issuer for Auth.js inside Docker (token/userinfo/jwks).
# AUTH_KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/atlas
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Production-like local auth. For a no-IdP bypass, set both to true (local only).
AUTH_DISABLED=false
NEXT_PUBLIC_DEV_AUTH=false
NEXT_PUBLIC_DEV_TENANT_ID=11111111-1111-1111-1111-111111111111
NEXT_PUBLIC_DEV_USER_ID=dev-admin
NEXT_PUBLIC_DEV_ROLE=tenant_admin
DEV_USER_PASSWORD=atlas-dev-password

# Model/search credentials (platform-owned defaults)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MOONSHOT_API_KEY=
NVIDIA_API_KEY=
GOOGLE_API_KEY=
EXA_API_KEY=

# Credential envelope encryption. Generate a Fernet key for local development.
CREDENTIAL_ENCRYPTION_KEY=dev-only-change-me-please-32b
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
DOCUMENT_BUCKET=atlas-documents
DOCUMENT_UPLOAD_DIR=/data/uploads

# Shared quotas, scheduler leader lock, sandbox run registry.
# Use memory:// for unit tests / single-process without Redis.
REDIS_URL=redis://:atlas-redis-dev@localhost:6379/0
REDIS_PASSWORD=atlas-redis-dev

# Unique per-process URL for sandbox proxy ownership (optional; falls back to callback base).
# SANDBOX_INSTANCE_URL=
SANDBOX_CALLBACK_BASE_URL=http://backend:7777

# Shared secret for sandbox-manager → backend HttpProxy callbacks.
SANDBOX_INTERNAL_TOKEN=dev-sandbox-internal-token-change-me

# SQLAlchemy pool (per process). Raise carefully with WEB_CONCURRENCY.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
WEB_CONCURRENCY=2

# Outbound REST tool policy (exact hostnames only; no wildcards).
# Platform default stays generic — add real API hosts per environment as needed.
REST_TOOL_ALLOWED_HOSTS=api.example.com,httpbin.org
# Admin API quotas apply in every ENVIRONMENT (including local compose).
# Set RATE_LIMITS_ENABLED=false only for deliberate local load tests.
RATE_LIMITS_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
TENANT_CONCURRENCY_LIMIT=10
MAX_UPLOAD_BYTES=10485760

# Resend email channel (inbound → published team/workflow → reply)
# Address shape: team-{tenantSlug}.{teamSlug}@{EMAIL_INBOUND_DOMAIN}
EMAIL_INBOUND_DOMAIN=
RESEND_WEBHOOK_SECRET=
# Optional platform fallback when a tenant has no Credentials provider "resend"
RESEND_API_KEY=
APP_PUBLIC_URL=http://localhost:3000

# Billing (dummy completes instantly; razorpay for live INR payments)
BILLING_PROVIDER=dummy
BILLING_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
